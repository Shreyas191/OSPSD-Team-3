# Copy this file to .env and fill in your own values. Never commit .env.
# App key and secret: Dropbox App Console -> your app -> Settings.
DROPBOX_APP_KEY=your-app-key
DROPBOX_APP_SECRET=your-app-secret
# Must exactly match a Redirect URI registered on the app's Settings tab.
DROPBOX_REDIRECT_URI=http://localhost:8080/oauth/callback

# Optional: where `login` saves your refresh token (default .dropbox_token.json, gitignored).
# DROPBOX_TOKEN_FILE=.dropbox_token.json
# Optional (CI): use this refresh token instead of the token file.
# DROPBOX_REFRESH_TOKEN=
# Optional (development fallback): a manually generated, short-lived access token.
# DROPBOX_ACCESS_TOKEN=
